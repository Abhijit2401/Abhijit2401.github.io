---
import Layout from '../layouts/Layout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects } from '../data/projects';

const links = [
	{ label: 'GitHub', href: 'https://github.com/Abhijit2401' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/abhijit-shidlagatta/' },
	{ label: 'itch.io', href: 'https://tijiboo.itch.io/' },
	{ label: 'CV (PDF)', href: '/Abhijit_Shidlagatta_CV.pdf' },
];

const email = 'abhijit.shidlagatta@outlook.com';

let mediaCount = 0;
const rows = projects.map((project) => ({
	project,
	flip: project.media ? mediaCount++ % 2 === 1 : false,
}));
---

<Layout
	title="Abhijit Shidlagatta | C++ Programmer"
	description="Portfolio of Abhijit Shidlagatta: real-time C++ work in games, graphics and simulation, including an FFT ocean and a destructible voxel dungeon."
>
	<nav class="topbar glass" aria-label="Sections">
		<a class="mark" href="#top" aria-label="Back to top">
			<img src="/art/doodles/chibi.webp" alt="" width="174" height="161" />
		</a>
		<a href="#projects">Projects</a>
		<a href="#sketchbook">Sketchbook</a>
		<a href="/Abhijit_Shidlagatta_CV.pdf">CV</a>
	</nav>

	<header class="hero" id="top">
		<img class="doodle chick" src="/art/doodles/chick.webp" alt="" aria-hidden="true" width="242" height="286" loading="lazy" data-drift="0.12" />
		<div class="wrap">
			<img class="doodle portrait" src="/art/doodles/portrait.webp" alt="" aria-hidden="true" width="467" height="522" loading="lazy" data-drift="0.05" />
			<p class="eyebrow" data-reveal style="--d: 0ms">C++ programmer · Real-time · Games · Graphics</p>
			<h1 data-reveal style="--d: 80ms">Abhijit Shidlagatta</h1>
			<details class="about" data-reveal style="--d: 160ms" open>
				<summary>About me</summary>
				<p class="intro">
					I graduated from City St George's, University of London in 2026 with a 2:1 in Computer Science.
					I like building things in C++ where performance matters: games, real-time graphics and simulation.
					I'm looking for a graduate software role in London.
				</p>
				<p class="intro">
					I also draw, which comes in handy at game jams.
				</p>
			</details>
			<nav class="hero-links" aria-label="Contact and profiles" data-reveal style="--d: 320ms">
				<a class="primary" href={`mailto:${email}`}>{email}</a>
				{links.map((l) => (
					<a class="glass" href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a>
				))}
			</nav>
		</div>
	</header>

	<main class="wrap" id="projects">
		<section aria-labelledby="work-heading">
			<h2 id="work-heading" data-reveal>Projects</h2>
			{
				rows.map(({ project, flip }) =>
					project.id === 'voxel-dungeon' ? (
						<div class="perch">
							<img class="cat cat-back" src="/art/doodles/cat.webp" alt="" aria-hidden="true" width="400" height="671" data-reveal />
							<ProjectRow project={project} flip={flip} />
							<img class="cat cat-front" src="/art/doodles/cat.webp" alt="" aria-hidden="true" width="400" height="671" data-reveal />
						</div>
					) : project.id === 'fft-ocean' ? (
						<div class="dock harbour">
							<ProjectRow project={project} flip={flip} />
							<img class="ship" src="/art/doodles/ship.webp" alt="" aria-hidden="true" width="720" height="291" loading="lazy" data-reveal />
						</div>
					) : project.id === 'ascii-filter' ? (
						<div class="dock">
							<ProjectRow project={project} flip={flip} />
							<img class="doodle alien" src="/art/doodles/alien.webp" alt="" aria-hidden="true" width="720" height="504" loading="lazy" data-drift="0.06" />
						</div>
					) : project.id === 'opengl-racer' ? (
						<div class="dock">
							<ProjectRow project={project} flip={flip} />
							<img class="doodle star" src="/art/doodles/star.webp" alt="" aria-hidden="true" width="572" height="256" loading="lazy" data-drift="0.1" />
						</div>
					) : (
						<ProjectRow project={project} flip={flip} />
					)
				)
			}
		</section>

		<section class="building" aria-labelledby="building-heading" data-reveal>
			<p class="building-label" id="building-heading">Currently building</p>
			<h3>Moss</h3>
			<p>
				My own small game engine in C++ and Vulkan, written from scratch. I'm using it to make a game for
				GitHub Game Off in November.
			</p>
			<ul class="building-tags">
				<li>C++</li>
				<li>Vulkan</li>
				<li>In progress</li>
			</ul>
		</section>
		<img class="doodle bug" src="/art/doodles/bug.webp" alt="" aria-hidden="true" width="197" height="164" loading="lazy" data-drift="0.08" />
	</main>

	<div class="dark-zone">
		<section class="sketchbook wrap" id="sketchbook" aria-labelledby="art-heading">
			<img class="doodle plant" src="/art/doodles/plant.webp" alt="" aria-hidden="true" width="522" height="640" loading="lazy" data-drift="0.04" />
			<img class="doodle face" src="/art/doodles/face.webp" alt="" aria-hidden="true" width="333" height="390" loading="lazy" data-drift="0.04" />
			<h2 id="art-heading" data-reveal>Sketchbook</h2>
			<p class="art-intro" data-reveal>
				I've been drawing on the side for years and I'm still learning. It came in useful at GMTK 2026:
				every sprite in <a href="https://tijiboo.itch.io/sign-of-the-times" target="_blank" rel="noopener">Sign of the Times</a>{' '}is
				mine, drawn in Piskel. Here's a loop from that game, some work from a PSX horror jam, and some sketches.
			</p>

			<h3 class="art-sub">Game art</h3>
			<figure class="feature" data-reveal>
				<video
					class="lazy-video"
					src="/art/gmtk-wisteria.mp4"
					poster="/art/gmtk-wisteria.jpg"
					aria-label="Pixel-art samurai walking through grass under a wisteria canopy with shafts of light"
					muted
					loop
					playsinline
					preload="none"
				></video>
				<figcaption>Sign of the Times (GMTK 2026). All the pixel art is mine, drawn in Piskel.</figcaption>
			</figure>
			<div class="art-grid pair" data-reveal>
				<figure>
					<img class="transparent" src="/art/hammer-swing.webp" alt="Hand-drawn first-person hammer swing animation" width="480" height="270" loading="lazy" />
					<figcaption>First-person hammer swing for the PSX horror jam, drawn frame by frame in Krita.</figcaption>
				</figure>
				<figure>
					<img class="blender" src="/art/angel-topology.jpg" alt="Wireframe of a winged angel character model in Blender" width="1060" height="900" loading="lazy" />
					<figcaption>Angel enemy for the same jam, modelled and rigged in Blender. It was my first proper character model, so I'm still improving my topology.</figcaption>
				</figure>
			</div>

			<h3 class="art-sub">Sketches</h3>
			<div class="sketch-top" data-reveal>
				<div class="sketch-stack">
					<figure>
						<img src="/art/malenia-vs-rowlet.jpg" alt="Sketch of Malenia from Elden Ring lunging at a small Rowlet" width="415" height="406" loading="lazy" />
						<figcaption>Malenia vs Rowlet</figcaption>
					</figure>
					<figure>
						<img src="/art/rowlet-reference.jpg" alt="Photo of a 3DS screen showing Rowlet facing Groudon" width="960" height="540" loading="lazy" />
						<figcaption>The reference: Rowlet squaring up to Groudon on my 3DS</figcaption>
					</figure>
				</div>
				<figure class="sketch-big">
					<img src="/art/pokemon-sketches.jpg" alt="Sheet of Pokémon sketches drawn in Krita" width="802" height="776" loading="lazy" />
					<figcaption>Pokémon sketches in Krita</figcaption>
				</figure>
			</div>
			<div class="sketch-row" data-reveal>
				<figure>
					<img src="/art/genji.jpg" alt="Digital sketch of a masked cyborg ninja in profile" width="1000" height="760" loading="lazy" />
					<figcaption>Genji (Overwatch)</figcaption>
				</figure>
				<figure>
					<img src="/art/hollowknight.jpg" alt="Loose digital sketch of the Knight from Hollow Knight" width="1000" height="566" loading="lazy" />
					<figcaption>Hollow Knight</figcaption>
				</figure>
				<figure>
					<img src="/art/aespa.jpg" alt="Pencil portrait of a young woman with short hair" width="657" height="619" loading="lazy" />
					<figcaption>Pencil portrait (aespa)</figcaption>
				</figure>
				<figure>
					<img src="/art/friends-cat.jpg" alt="Pencil drawing of a black and white cat" width="593" height="646" loading="lazy" />
					<figcaption>My friend's cat, in pencil</figcaption>
				</figure>
			</div>
		</section>

	<footer class="wrap">
		<img class="doodle hedgehog" src="/art/doodles/hedgehog.webp" alt="" aria-hidden="true" width="533" height="383" loading="lazy" />
		<p>
			<a href={`mailto:${email}`}>{email}</a>
			<span aria-hidden="true"> · </span>
			<a href="https://github.com/Abhijit2401" target="_blank" rel="noopener">GitHub</a>
			<span aria-hidden="true"> · </span>
			<a href="https://www.linkedin.com/in/abhijit-shidlagatta/" target="_blank" rel="noopener">LinkedIn</a>
		</p>
		<p class="small">© 2026 Abhijit Shidlagatta</p>
	</footer>
	</div>
</Layout>

<style>
	.wrap {
		max-width: var(--max);
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.topbar {
		position: fixed;
		top: 0.9rem;
		left: 50%;
		translate: -50% 0;
		z-index: 50;
		display: flex;
		align-items: center;
		gap: 0.15rem;
		padding: 0.3rem;
		border-radius: 999px;
		--glass-fill: 0.3;
		--glass-blur: 6px;
	}

	.topbar a {
		flex: none;
		white-space: nowrap;
		display: inline-flex;
		align-items: center;
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 550;
		color: var(--text);
		text-decoration: none;
		transition: background-color 0.2s ease;
	}

	.topbar a:hover {
		background: color-mix(in srgb, var(--text) 8%, transparent);
	}

	.topbar .mark {
		padding: 0.1rem;
	}

	.topbar .mark img {
		flex: none;
		width: 2.3rem;
		height: 2.3rem;
		padding: 0.1rem;
		border-radius: 50%;
		object-fit: contain;
		background: #fff;
		box-shadow: 0 0 0 1px var(--glass-border);
		transition: rotate 0.3s var(--ease);
	}

	.topbar .mark:hover img {
		rotate: -10deg;
	}

	#top,
	#projects,
	#sketchbook {
		scroll-margin-top: 4.5rem;
	}

	#top {
		scroll-margin-top: 0;
	}

	.hero {
		padding: 8rem 0 4.5rem;
	}

	.hero .wrap {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 1.4rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.eyebrow::before {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 12px var(--accent);
	}

	h1 {
		margin: 0 0 1.75rem;
		font-size: clamp(2.8rem, 8vw, 5.6rem);
		line-height: 1;
		background: linear-gradient(180deg, var(--heading) 30%, color-mix(in srgb, var(--heading) 60%, var(--accent)));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		padding-bottom: 0.08em;
	}

	.intro {
		max-width: 42rem;
		margin: 0 0 1rem;
		font-size: 1.2rem;
		line-height: 1.65;
		color: var(--muted);
	}

	.about summary {
		display: none;
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin-top: 2rem;
	}

	.hero-links a {
		font-size: 0.95rem;
		font-weight: 550;
		text-decoration: none;
		color: var(--text);
		padding: 0.6rem 1.1rem;
		border-radius: 999px;
		box-shadow: inset 0 1px 0 var(--glass-highlight);
		transition: border-color 0.2s ease;
	}

	.hero-links a:hover {
		border-color: color-mix(in srgb, var(--accent) 50%, var(--glass-border));
	}

	.hero-links a.primary {
		color: var(--on-accent);
		background: var(--accent);
		border: 1px solid transparent;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.4),
			0 8px 30px color-mix(in srgb, var(--accent) 35%, transparent);
	}

	.hero-links a.primary:hover {
		background: color-mix(in srgb, var(--accent) 85%, white);
	}

	@media (max-width: 860px) {
		.hero {
			padding: 6rem 0 3rem;
		}

		.hero-links {
			order: 3;
		}

		.about {
			order: 4;
			width: 100%;
			margin-top: 1.75rem;
			border-top: 1px solid var(--glass-border);
			padding-top: 1rem;
			interpolate-size: allow-keywords;
		}

		.about summary {
			display: flex;
			align-items: center;
			justify-content: space-between;
			cursor: pointer;
			list-style: none;
			font-family: var(--head);
			font-weight: var(--head-weight);
			font-size: 1.15rem;
			color: var(--heading);
			padding: 0.4rem 0;
		}

		.about summary::-webkit-details-marker {
			display: none;
		}

		.about summary::after {
			content: '+';
			font-size: 1.5rem;
			color: var(--accent);
			transition: transform 0.3s ease;
		}

		.about[open] summary::after {
			transform: rotate(45deg);
		}

		.about::details-content {
			height: 0;
			overflow: hidden;
			transition:
				height 0.4s ease,
				content-visibility 0.4s allow-discrete;
		}

		.about[open]::details-content {
			height: auto;
		}

		.about .intro:first-of-type {
			margin-top: 0.75rem;
		}

		.intro {
			font-size: 1.08rem;
		}
	}

	main {
		padding-top: 3rem;
	}

	.building {
		margin-top: 3rem;
		padding: 1.5rem 1.75rem;
		border: 1px dashed color-mix(in srgb, var(--accent) 45%, var(--glass-border));
		border-radius: var(--radius-sm);
		max-width: 42rem;
	}

	.building-label {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 0.5rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.building-label::before {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 12px var(--accent);
	}

	.building h3 {
		margin: 0 0 0.5rem;
		font-size: 1.5rem;
	}

	.building p {
		margin: 0 0 1rem;
		color: var(--muted);
	}

	.building-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.building-tags li {
		font-family: var(--mono);
		font-size: 0.75rem;
		padding: 0.3rem 0.65rem;
		border-radius: 999px;
		border: 1px solid var(--glass-border);
		color: var(--text);
	}

	h2 {
		font-size: clamp(2rem, 4.5vw, 3rem);
		line-height: 1.1;
		margin: 0 0 2.25rem;
	}

	h2::after {
		content: '';
		display: block;
		width: 4.6em;
		height: 0.45em;
		margin-top: 0.25rem;
		background: linear-gradient(90deg, var(--accent), var(--accent-2));
		-webkit-mask: url('/art/doodles/underline-1.webp') center / 100% 100% no-repeat;
		mask: url('/art/doodles/underline-1.webp') center / 100% 100% no-repeat;
	}

	.sketchbook > h2::after {
		width: 5.6em;
		height: 0.35em;
		-webkit-mask-image: url('/art/doodles/underline-2.webp');
		mask-image: url('/art/doodles/underline-2.webp');
	}

	.dark-zone {
		position: relative;
		margin-top: 3rem;
		background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--bg-deep) 85%, transparent) 12rem);
	}

	.dark-zone::before {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		width: min(var(--max), 100% - 3rem);
		height: 1px;
		translate: -50% 0;
		background: linear-gradient(90deg, transparent, var(--glass-border), transparent);
	}

	.sketchbook {
		padding-top: 5.5rem;
	}

	.art-intro {
		max-width: 42rem;
		color: var(--muted);
		margin: 0 0 2rem;
	}

	.art-sub {
		font-size: 1.3rem;
		margin: 3rem 0 1.1rem;
	}

	figure {
		margin: 0;
	}

	figure img,
	.feature video {
		width: 100%;
		height: auto;
		border-radius: var(--radius-sm);
		border: 1px solid var(--glass-border);
		background: rgba(var(--glass-tint), var(--glass-fill));
		box-shadow: var(--shadow);
	}

	.feature {
		max-width: 852px;
		margin: 0 auto;
	}

	.feature video {
		aspect-ratio: 426 / 240;
		image-rendering: pixelated;
	}

	.art-grid.pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 1.25rem;
		align-items: start;
	}

	.art-grid.pair img {
		aspect-ratio: 4 / 3;
		object-fit: contain;
	}

	img.blender {
		background: #3d3d3d;
	}

	figure img.transparent {
		background: transparent;
		border-color: transparent;
		box-shadow: none;
	}

	.sketch-top {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 1rem;
		align-items: start;
	}

	.sketch-stack {
		display: grid;
		gap: 1rem;
	}

	.sketch-row {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin-top: 1rem;
		align-items: start;
	}

	figure img {
		transition: translate 0.4s var(--ease);
	}

	figure:hover img:not(.transparent) {
		translate: 0 -3px;
	}

	figcaption {
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--muted);
		margin-top: 0.6rem;
	}

	footer.wrap {
		padding-top: 2rem;
		padding-bottom: 3rem;
		border-top: 1px solid var(--glass-border);
		color: var(--muted);
	}

	footer p {
		margin: 0 0 0.4rem;
	}

	footer a {
		text-decoration: none;
	}

	footer a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.small {
		font-family: var(--mono);
		font-size: 0.75rem;
	}

	@media (max-width: 860px) {
		.sketch-row {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 620px) {
		.art-grid.pair,
		.sketch-top {
			grid-template-columns: 1fr;
		}
	}

	.hero .wrap,
	main.wrap,
	.sketchbook,
	footer.wrap {
		position: relative;
	}

	.doodle {
		position: absolute;
		z-index: 1;
		height: auto;
		rotate: var(--tilt, 0deg);
		user-select: none;
		-webkit-user-drag: none;
	}

	.motion .doodle:hover {
		animation: wobble 0.7s var(--ease);
	}

	@keyframes wobble {
		30% {
			transform: rotate(-7deg) scale(1.05);
		}
		60% {
			transform: rotate(5deg) scale(1.05);
		}
	}

	.motion .chick {
		animation: bob 5s ease-in-out infinite;
	}

	@keyframes bob {
		50% {
			transform: translateY(-10px);
		}
	}

	.portrait {
		top: 2.5rem;
		right: 2.5rem;
		width: 190px;
		--tilt: 5deg;
	}

	.hero {
		position: relative;
	}

	.chick {
		top: 1.25rem;
		left: max(1.5rem, 50% - var(--max) / 2 - 6rem);
		width: 80px;
		--tilt: -8deg;
	}

	.bug {
		top: 22%;
		left: -9.5rem;
		width: 105px;
		--tilt: -12deg;
	}

	.star {
		top: 30%;
		right: calc(100% + 2rem);
		width: 175px;
		--tilt: -8deg;
	}

	.plant {
		top: 1rem;
		left: calc(50% - 50vw - 1.25rem);
		width: clamp(150px, 20vw, 320px);
		--tilt: -5deg;
	}

	.sketchbook > h2,
	.art-intro {
		margin-left: auto;
	}

	.sketchbook > h2 {
		text-align: right;
	}

	.sketchbook > h2::after {
		margin-left: auto;
	}

	.hedgehog {
		bottom: calc(100% - 0.6rem);
		right: 2rem;
		width: 190px;
		z-index: 0;
	}

	footer.wrap {
		margin-top: 10rem;
	}

	.perch {
		position: relative;
		--cat-w: 185px;
		--ledge: calc(var(--cat-w) * 671 / 400 * 0.25);
	}

	.cat {
		position: absolute;
		left: 30%;
		top: calc(-1 * var(--ledge));
		width: var(--cat-w);
		height: auto;
		pointer-events: none;
		user-select: none;
	}

	.cat-back {
		clip-path: inset(var(--ledge) 0 0 0);
		filter: brightness(0.15) contrast(1.4);
		opacity: 0.85;
	}

	.cat-front {
		-webkit-mask-image: linear-gradient(#000 calc(var(--ledge) + 1rem), transparent calc(var(--ledge) + 2rem));
		mask-image: linear-gradient(#000 calc(var(--ledge) + 1rem), transparent calc(var(--ledge) + 2rem));
	}



	.dock {
		position: relative;
	}

	.ship {
		position: absolute;
		right: 10%;
		top: 0.4rem;
		width: 250px;
		height: auto;
		z-index: 1;
		pointer-events: none;
		transform-origin: 50% 80%;
	}

	.motion .ship {
		animation: rock 4s ease-in-out infinite;
	}

	@keyframes rock {
		0%,
		100% {
			transform: rotate(-2deg) translateY(0);
		}
		50% {
			transform: rotate(2deg) translateY(-3px);
		}
	}

	.face {
		top: 0.5rem;
		right: calc(50% - 50vw - 1rem);
		width: clamp(150px, 13vw, 230px);
		--tilt: 6deg;
	}

	.alien {
		top: 20%;
		left: calc(100% + 1rem);
		width: clamp(175px, 13vw, 260px);
		--tilt: 5deg;
	}
	@media (max-width: 1440px) {
		.bug,
		.star,
		.alien,
		.face {
			display: none;
		}
	}

	@media (max-width: 1000px) {
		.portrait,
		.chick {
			display: none;
		}
	}

	@media (max-width: 860px) {
		.plant {
			width: 112px;
			left: calc(50% - 50vw - 0.4rem);
			top: 0.5rem;
		}

		.perch {
			--cat-w: 130px;
		}

		.cat {
			left: auto;
			right: 12%;
		}

		.hedgehog {
			width: 130px;
			right: 1rem;
		}

		.harbour {
			margin-top: 3rem;
		}

		.ship {
			width: 170px;
			right: 6%;
			top: auto;
			bottom: calc(100% - 2.1rem);
		}

		footer.wrap {
			margin-top: 8rem;
		}
