---
import Layout from '../layouts/Layout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects } from '../data/projects';

const links = [
	{ label: 'GitHub', href: 'https://github.com/Abhijit2401' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/abhijit-shidlagatta/' },
	{ label: 'itch.io', href: 'https://tijiboo.itch.io/' },
	{ label: 'CV (PDF)', href: '/Abhijit_Shidlagatta_CV.pdf' },
];

const email = 'abhijit.shidlagatta@outlook.com';
---

<Layout
	title="Abhijit Shidlagatta | C++ Programmer"
	description="Portfolio of Abhijit Shidlagatta: real-time C++ work in games, graphics and simulation, including a destructible voxel dungeon, a Vulkan game engine and a Souls-like."
>
	<div class="page">
		<header>
			<p class="eyebrow">C++ and C# programmer · Games · Interactive software</p>
			<h1>Abhijit Shidlagatta</h1>
			<p>
				I graduated from City St George's, University of London in 2026 with a 2:1 in Computer Science.
				I build interactive software in C++ and C#, mostly games, game engines and real-time tools.
				I'm based in Twickenham and looking for a graduate software role in the UK.
			</p>
			<p class="contact">
				<a href={`mailto:${email}`}>{email}</a>
				{
					links.map((l) => (
						<a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a>
					))
				}
			</p>
		</header>

		<main>
			<h2>Projects</h2>
			{projects.map((project) => <ProjectRow project={project} />)}

			<section class="building" aria-labelledby="building-heading">
				<h2 id="building-heading">Currently working on</h2>
				<h3>Voxel Dungeon V2</h3>
				<p>
					Rebuilding my dissertation in Unreal Engine 5.8, replacing the Voxel Plugin with my own voxel storage
					and mesher.
				</p>
				<p class="tags">C++ · Unreal Engine 5.8 · In progress</p>
				<h3>FFT ocean in Unreal Engine 5</h3>
				<p>
					Learning how FFT ocean simulation works by building one with compute shaders.
				</p>
				<p class="tags">C++ · HLSL · In progress</p>
			</section>
		</main>

		<footer>
			<p>© 2026 Abhijit Shidlagatta</p>
		</footer>
	</div>
</Layout>

<style>
	.page {
		max-width: var(--max);
		margin: 0 auto;
		padding: 3rem 1.25rem 4rem;
	}

	header {
		margin-bottom: 3rem;
	}

	.eyebrow,
	.tags {
		font-family: var(--mono);
		font-size: 0.85rem;
		color: var(--muted);
	}

	h1 {
		font-size: 2.4rem;
		margin: 0.5rem 0 1rem;
	}

	h2 {
		font-size: 1.6rem;
		margin-bottom: 1rem;
	}

	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}

	.building {
		padding-top: 1.75rem;
		border-top: 1px solid var(--border);
	}

	.building h3 {
		font-size: 1.3rem;
		margin-bottom: 0.5rem;
	}

	.building h3:not(:first-of-type) {
		margin-top: 1.5rem;
	}

	footer {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		font-size: 0.85rem;
		color: var(--muted);
	}
</style>
