---
interface Props {
	title: string;
	description: string;
}

import '@fontsource/cinzel/latin-500.css';
import '@fontsource/cinzel/latin-700.css';
import '@fontsource/crimson-pro/latin-400.css';
import '@fontsource/crimson-pro/latin-400-italic.css';
import '@fontsource/crimson-pro/latin-600.css';

const { title, description } = Astro.props;
const ogImage = new URL('/video/ocean.jpg', Astro.site);
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Abhijit Shidlagatta" />
		<link rel="canonical" href={Astro.url} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />

		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('motion');
			}
		</script>
	</head>
	<body>
		<slot />
		<script>
			const items = document.querySelectorAll('[data-reveal]');
			if (document.documentElement.classList.contains('motion') && 'IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('revealed');
								io.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
				);
				items.forEach((el) => io.observe(el));
			} else {
				items.forEach((el) => el.classList.add('revealed'));
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #1c1c1a;
		--bg-deep: #121211;
		--panel: #2a2a28;
		--line: #3d3d3a;
		--text: #e8e5df;
		--muted: #a3a29b;
		--sage: #8a9a86;
		--clay: #c18a75;
		--sand: #d4c9a8;
		--max: 1100px;
		--head: 'Cinzel', Georgia, serif;
		--body: 'Crimson Pro', Georgia, serif;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: var(--body);
		font-size: 1.25rem;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	h1,
	h2,
	h3 {
		font-family: var(--head);
		font-weight: 500;
	}

	a {
		color: var(--clay);
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--sand);
		outline-offset: 3px;
	}

	img,
	video {
		max-width: 100%;
		display: block;
	}

	.motion [data-reveal] {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms),
			transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms);
	}

	.motion [data-reveal].revealed {
		opacity: 1;
		transform: none;
	}
</style>
