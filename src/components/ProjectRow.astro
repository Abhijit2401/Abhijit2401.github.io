---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
const { title, context, year, paragraphs, tags, media, links } = project;
---

<article class="project" id={project.id}>
	<h3>{title}</h3>
	<p class="meta">{context} · {year}</p>
	<video
		class="clip"
		src={media.video}
		poster={media.poster}
		aria-label={media.alt}
		muted
		loop
		playsinline
		preload="none"
	></video>
	{paragraphs.map((p) => <p>{p}</p>)}
	<p class="tags">{tags.join(' · ')}</p>
	{
		links.length > 0 && (
			<p class="links">
				{links.map((l) => (
					<a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
						{l.label}
					</a>
				))}
			</p>
		)
	}
</article>

<script>
	const clips = document.querySelectorAll<HTMLVideoElement>('video.clip');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reduceMotion && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const clip = entry.target as HTMLVideoElement;
					if (entry.isIntersecting) clip.play().catch(() => {});
					else clip.pause();
				}
			},
			{ threshold: 0.5 }
		);
		clips.forEach((clip) => observer.observe(clip));
	} else {
		clips.forEach((clip) => (clip.controls = true));
	}
</script>

<style>
	.clip {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		margin: 0.75rem 0 1rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--border);
	}

	.project {
		padding: 1.75rem 0;
		border-top: 1px solid var(--border);
	}

	h3 {
		font-size: 1.3rem;
		margin-bottom: 0.25rem;
	}

	p {
		margin: 0 0 0.75rem;
	}

	.meta,
	.tags {
		font-family: var(--mono);
		font-size: 0.85rem;
		color: var(--muted);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin-bottom: 0;
	}
</style>
