---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	flip?: boolean;
}

const { project, flip = false } = Astro.props;
const { title, context, year, paragraphs, tags, media, links, featured } = project;
---

<article class:list={['row', 'glass', { flip, featured, 'no-media': !media }]} id={project.id} data-reveal>
	<span class="spot" aria-hidden="true"></span>
	{
		media && (
			<div class="media hover-media" tabindex="0">
				<video
					class="hover-video"
					src={media.video}
					poster={media.poster}
					aria-label={media.alt}
					muted
					loop
					playsinline
					preload="none"
				/>
				<span class="play-hint" aria-hidden="true">▶ Hover to play</span>
			</div>
		)
	}

	<div class="body">
		<p class="meta">{context} <span aria-hidden="true">·</span> {year}</p>
		<h3>{title}</h3>
		{paragraphs.map((p) => <p>{p}</p>)}
		<ul class="tags" aria-label="Tech used">
			{tags.map((t) => <li>{t}</li>)}
		</ul>
		<div class="links">
			{
				links.map((l) => (
					<a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
						{l.label} <span aria-hidden="true">→</span>
					</a>
				))
			}
		</div>
	</div>
</article>

<script>
	const noHover = window.matchMedia('(hover: none)').matches;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const autoplay = noHover && !reduceMotion && 'IntersectionObserver' in window;

	const watcher = autoplay
		? new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						const box = entry.target as HTMLElement;
						if (entry.isIntersecting && !box.dataset.userPaused) box.dispatchEvent(new Event('autoplay'));
						else if (!entry.isIntersecting) box.dispatchEvent(new Event('autopause'));
					}
				},
				{ threshold: 0.6 }
			)
		: null;

	document.querySelectorAll<HTMLElement>('.hover-media').forEach((box) => {
		const video = box.querySelector('video');
		if (!video) return;

		const hint = box.querySelector('.play-hint');
		if (hint && noHover) hint.textContent = '▶ Tap to play';

		const play = () => {
			video.preload = 'auto';
			video.play().catch(() => {});
			box.classList.add('playing');
		};
		const pause = () => {
			video.pause();
			box.classList.remove('playing');
		};

		box.addEventListener('pointerenter', (e) => {
			if (e.pointerType === 'mouse') play();
		});
		box.addEventListener('pointerleave', (e) => {
			if (e.pointerType === 'mouse') pause();
		});
		box.addEventListener('pointerup', (e) => {
			if (e.pointerType === 'mouse') return;
			if (video.paused) {
				delete box.dataset.userPaused;
				play();
			} else {
				box.dataset.userPaused = 'true';
				pause();
			}
		});
		box.addEventListener('focus', () => {
			if (!box.dataset.userPaused) play();
		});
		box.addEventListener('blur', pause);
		box.addEventListener('autoplay', play);
		box.addEventListener('autopause', pause);
		watcher?.observe(box);
	});

	if (!noHover && !reduceMotion) {
		document.querySelectorAll<HTMLElement>('.row').forEach((row) => {
			const spot = row.querySelector<HTMLElement>('.spot');
			if (!spot) return;
			let x = 0;
			let y = 0;
			let queued = false;
			row.addEventListener('pointermove', (e) => {
				x = e.clientX;
				y = e.clientY;
				if (queued) return;
				queued = true;
				requestAnimationFrame(() => {
					queued = false;
					const r = row.getBoundingClientRect();
					spot.style.transform = `translate(${x - r.left}px, ${y - r.top}px)`;
				});
			});
		});
	}
</script>

<style>
	.hover-media {
		position: relative;
		cursor: pointer;
	}

	.play-hint {
		position: absolute;
		left: 0.75rem;
		bottom: 0.75rem;
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		font-family: var(--mono);
		font-size: 0.7rem;
		letter-spacing: 0.02em;
		color: #fff;
		background: rgba(10, 12, 18, 0.45);
		-webkit-backdrop-filter: blur(12px) saturate(160%);
		backdrop-filter: blur(12px) saturate(160%);
		border: 1px solid rgba(255, 255, 255, 0.18);
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	.hover-media.playing .play-hint {
		opacity: 0;
	}

	.row {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 2.25rem;
		align-items: center;
		position: relative;
		overflow: clip;
		overflow-clip-margin: 2px;
		padding: 1.25rem;
		margin-bottom: 1.75rem;
		border-radius: var(--radius);
	}

	.row:hover {
		border-color: color-mix(in srgb, var(--accent) 35%, var(--glass-border));
	}

	.row > .spot {
		position: absolute;
		top: -420px;
		left: -420px;
		width: 840px;
		height: 840px;
		background: radial-gradient(circle, var(--spot), transparent 65%);
		opacity: 0;
		transition: opacity 0.25s ease;
		pointer-events: none;
		will-change: transform;
	}

	.row:hover > .spot {
		opacity: 1;
	}

	.row > * {
		position: relative;
	}

	.row:last-child {
		margin-bottom: 4rem;
	}

	.row.flip {
		grid-template-columns: 1fr 1.2fr;
	}

	.row.flip .media {
		order: 2;
	}

	.row.featured {
		grid-template-columns: 1.1fr 1fr;
	}

	.row.featured.flip {
		grid-template-columns: 1fr 1.1fr;
	}

	.row.no-media {
		grid-template-columns: 1fr;
		padding: 1.75rem 2rem;
	}

	.row.no-media .body {
		max-width: 720px;
	}

	.body {
		padding: 0.5rem 0.75rem 0.5rem 0;
	}

	.row.flip .body {
		padding: 0.5rem 0 0.5rem 0.75rem;
	}

	.media {
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: var(--bg-deep);
		aspect-ratio: 16 / 9;
		box-shadow: 0 0 0 1px var(--glass-border);
	}

	.media video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 0.6s var(--ease);
	}

	.hover-media.playing video {
		scale: 1.02;
	}

	.meta {
		margin: 0 0 0.5rem;
		font-family: var(--mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent);
	}

	h3 {
		margin: 0 0 0.9rem;
		font-size: 1.75rem;
		line-height: 1.15;
	}

	.body p:not(.meta) {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 1.02rem;
		line-height: 1.6;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 1.1rem 0 1.25rem;
	}

	.tags li {
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--text);
		background: rgba(var(--glass-tint), calc(var(--glass-fill) + 0.03));
		border: 1px solid var(--glass-border);
		padding: 0.25rem 0.65rem;
		border-radius: 999px;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.4rem;
	}

	.links a {
		position: relative;
		font-weight: 600;
		font-size: 0.98rem;
		text-decoration: none;
	}

	.links a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s var(--ease);
	}

	.links a:hover::after {
		transform: scaleX(1);
	}

	.links a span {
		display: inline-block;
		transition: translate 0.3s var(--ease);
	}

	.links a:hover span {
		translate: 3px 0;
	}

	@media (max-width: 860px) {
		.row,
		.row.featured,
		.row.flip,
		.row.featured.flip {
			grid-template-columns: 1fr;
			gap: 1.25rem;
			padding: 0.9rem;
			margin-bottom: 1.25rem;
		}

		.body,
		.row.flip .body {
			padding: 0 0.4rem 0.4rem;
		}

		.row.no-media {
			padding: 1.25rem;
		}

		.row.flip .media {
			order: 0;
		}

		h3 {
			font-size: 1.5rem;
		}
	}
</style>
